# Copiar a .env en Coolify y completar desde el panel. Este archivo NO lleva valores.

OPENAI_BASE_URL=
PDC_LLM_KEY=
PDC_MODEL_PRODUCER=
PDC_MODEL_JUDGE=

PDC_WP_URL=
PDC_WP_TOKEN=
PDC_WP_USER=leandro

GSC_CUENTA_SERVICIO_JSON=

PDC_CHAT_WEBHOOK_URL=

PDC_STATE_DIR=/data/state
PDC_MAX_PIECES_PER_DAY=2
PRESUPUESTO_LITELLM_USD=

# Portada: el gateway genera en 1536x1024; el pipeline recomprime a WebP <300 KB.
PDC_IMAGE_SIZE=1536x1024
PDC_IMAGE_FORMAT=webp
PDC_IMAGE_QUALITY=high
PDC_IMAGE_MAX_KB=300
